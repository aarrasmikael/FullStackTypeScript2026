# Kopioi tämä tiedostoon .env ja vaihda salaisuudet omiksesi
DATABASE_URL="postgresql://fsrtn:fsrtn@localhost:5434/fsrtn"
PORT=4000
NODE_ENV=development

# Eri salaisuus access ja refresh tokenille (vähintään 32 merkkiä)
# Luo esimerkiksi: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=vaihda-minut-access-secret-vahintaan-32-merkkia
JWT_REFRESH_SECRET=vaihda-minut-refresh-secret-eri-kuin-access-32
